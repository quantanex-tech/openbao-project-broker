# Copy outside the checkout. Replace these nonsecret paths for your installation.
# Shell example only: Python does not load it automatically. No credential values.
PROJECT_BROKER_CONFIG="$HOME/.config/openbao-project-broker/projects.json"
PROJECT_BROKER_CREDENTIALS="$HOME/.config/openbao-project-broker/approle.json"
PROJECT_ACCESS_SOCKET="$XDG_RUNTIME_DIR/openbao-project-broker/broker.sock"
PROJECT_BROKER_AUDIT="$HOME/.local/state/openbao-project-broker/audit.jsonl"
# In a trusted operator shell, use `set -a` before sourcing and `set +a` afterwards.
# For systemd, use the unit template; systemd does not expand shell variables here.
